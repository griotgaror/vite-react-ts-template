{
    "name": "application",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": " vite --config vite.config.mts",
        "build": "vite build --config vite.config.mts",
        "lint:check": "npx eslint ./src",
        "lint:fix": "npx eslint ./src --fix",
        "prettier:check": "npx prettier ./src --check",
        "prettier:fix": "npx prettier ./src --write",
        "format": "npm run prettier:fix && npm run lint:fix",
        "test": "vitest --run",
        "test:ui": "vitest --ui",
        "bump-version": "node nextVersion.cjs",
        "bump-version:auto-commit": "node nextVersion.cjs --auto-commit",
        "submodule-update": "git submodule update --remote",
        "prepare": "husky"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "babel-plugin-styled-components": "^2.3.0",
        "framer-motion": "^12.42.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-icons": "^5.7.0",
        "react-responsive": "^9.0.2",
        "react-router-dom": "^6.30.4",
        "react-spinners": "^0.17.0",
        "styled-components": "^6.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@types/jest": "^29.5.14",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/styled-components": "^5.1.36",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/ui": "^4.1.11",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "husky": "^9.1.7",
        "jsdom": "^25.0.1",
        "prettier": "3.9.4",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vite-plugin-checker": "^0.14.4",
        "vite-plugin-html": "^3.2.2",
        "vitest": "^4.1.11"
    }
}
